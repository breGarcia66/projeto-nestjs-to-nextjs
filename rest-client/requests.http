@baseUrl = http://localhost:3000

@token = {{authLogin.response.body.accessToken}}

# ROTAS DE MÉTODO "GET"

### Read All User
# @name readAllUser
GET {{baseUrl}}/user

### Read One User
# @name readOneUserById
GET {{baseUrl}}/user/80add8ed-8704-4ccb-90a7-5d268b6beff8
Authorization: Bearer {{token}}


### Find By Email
# @name findByEmail
GET {{baseUrl}}/user?email=levy@email.com

# ROTAS DE MÉTODO "POST"

### Auth Login
# @name authLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "levy@email.com",
  "password": "mypass123"
}

### Create User
# @name createUser
POST {{baseUrl}}/user
Content-Type: application/json

{
  "name": "levy",
  "email": "levy@email.com",
  "password": "123456"
}

# ROTAS DE MÉTODO "PUT"

### Update User
# @name updateUser
PATCH {{baseUrl}}/user/me
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "email":"levy@email.com"
}

### Update Password
# @name updatePassword
PATCH {{baseUrl}}/user/me/password
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "currentPassword": "mypass12",
  "newPassword": "mypass123"
}

