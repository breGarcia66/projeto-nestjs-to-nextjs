@baseUrl = http://localhost:3000
@token = {{authLogin.response.body.accessToken}}

# ROTAS DE MÉTODO "GET"

### Read All User
# @name readAllUser
GET {{baseUrl}}/user

### Read One User
# @name readOneUserById
GET {{baseUrl}}/user/98da17c4-abd2-4f4f-ac12-e57e4b7b2896
Authorization: Bearer {{token}}

### Read Logged In User
# @name readLoggedInUser
GET {{baseUrl}}/user/me
Authorization: Bearer {{token}}

# ROTAS DE MÉTODO "POST"

### Auth Login
# @name authLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "levy@email.com",
  "password": "123456"
}

### Create User
# @name createUser
POST {{baseUrl}}/user
Content-Type: application/json

{
  "name": "levy",
  "email": "levy@email.com",
  "password": "123456"
}

# ROTAS DE MÉTODO "PUT"

### Update User
# @name updateUser
PATCH {{baseUrl}}/user/me
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "email":"levy@email.com"
}

### Update Password
# @name updatePassword
PATCH {{baseUrl}}/user/me/password
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "currentPassword": "123456",
  "newPassword": "mypass123"
}

# ROTAS DE MÉTODO "DELETE"

### Delete My Account
# @name deleteMyAccount
DELETE {{baseUrl}}/user/me
Authorization: Bearer {{token}}
