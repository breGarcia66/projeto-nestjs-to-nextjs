@baseUrl = http://localhost:3000

### Auth Login
# @name authLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "brennolevy@email.com",
  "password": "123456"
}

### Read All User
# @name readAllUser
GET {{baseUrl}}/user

### Read One User
# @name readOneUser
GET {{baseUrl}}/user/a52ae402-2699-40cf-a07a-20f9dc42deb8

### Find By Email
# @name findByEmail
GET {{baseUrl}}/user?user=brennolevy@email.com

### Create User
# @name createUser
POST {{baseUrl}}/user
Content-Type: application/json

{
  "name": "Brenno Levy",
  "email": "brennolevy@email.com",
  "password": "123456"
}
