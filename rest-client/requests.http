@baseUrl = http://localhost:3000

### Auth Login
# @name authLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "my_name",
  "email": "email@example.com",
  "password": "mypass123",
  "random": "random"
}

### Read One User
# @name readOneUser
GET {{baseUrl}}/user/676767